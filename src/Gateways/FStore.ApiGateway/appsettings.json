{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Key": "super_secret_key_that_is_at_least_32_characters_long!",
    "Issuer": "FStore.Identity",
    "Audience": "FStore.Client"
  },
  "ReverseProxy": {
    "identity-route": {
      "ClusterId": "identity-cluster",
      "Match": {
        "Path": "/identity/{**catch-all}"
      },
      "Transforms": [
        {
          "PathRemovePrefix": "/identity"
        }
      ]
    },
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/catalog"
          }
        ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/basket/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/basket"
          }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/order"
          }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket-api": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-api": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "Clusters": {
        "identity-cluster": {
          "Destinations": {
            "identity-api": {
              "Address": "http://localhost:5004/"
            }
          }
        }
      }
    }
  }
}